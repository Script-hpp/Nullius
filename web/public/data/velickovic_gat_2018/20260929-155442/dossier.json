  "setup_details": [
    {
      "topic": "neighborhood definition",
      "value": "first-order neighbors of i (including i)",
      "quote": "In all our experiments, these will be exactly the first-order neighbors of i (including i).",
      "source": "paper"
    },
    {
      "topic": "shared linear transformation",
      "value": "weight matrix W ∈ R^{F'×F} applied to every node",
      "quote": "a shared linear transformation, parametrized by a weight matrix , W ∈ RF ′×F , is applied to every node.",
      "source": "paper"
    },
    {
      "topic": "dataset",
      "value": "Cora",
      "quote": "The Cora dataset contains 2708 nodes, 5429 edges, 7 classes and 1433 features per node.",
      "source": "paper"
    },
    {
      "topic": "preprocessing",
      "value": "bag-of-words representation",
      "quote": "Node features correspond to elements of a bag-of-words representation of a document.",
      "source": "paper"
    },
    {
      "topic": "training_split",
      "value": "20 nodes per class (total 140)",
      "quote": "We allow for only 20 nodes per class to be used for training—however, honoring the transductive setup, the training algorithm has access to all of the nodes’ feature vectors.",
      "source": "paper"
    },
    {
      "topic": "evaluation_protocol",
      "value": "accuracy on test set",
      "quote": "The predictive power of the trained models is evaluated on 1000 test nodes, and we use 500 additional nodes for validation purposes (the same ones as used by Kipf & Welling (2017)).",
      "source": "paper"
    },
    {
      "topic": "model_type",
      "value": "two-layer GAT model",
      "quote": "For the transductive learning tasks, we apply a two-layer GAT model.",
      "source": "paper"
    },
    {
      "topic": "first_layer_attention_heads",
      "value": "K = 8 attention heads computing F' = 8 features each (total 64 features)",
      "quote": "The first layer consists of K = 8 attention heads computing F ′ = 8 features each (for a total of 64 features), followed by an exponential linear unit (ELU) (Clevert et al., 2016) nonlinearity.",
      "source": "paper"
    },
    {
      "topic": "second_layer_attention_heads",
      "value": "single attention head computing C features (number of classes)",
      "quote": "The second layer is used for classification: a single attention head that computes C features (where C is the number of classes), followed by a softmax activation.",
      "source": "paper"
    },
    {
      "topic": "L2_regularization_lambda",
      "value": "0.0005",
      "quote": "During training, we apply L2 regulariza-tion with λ = 0 .0005 .",
      "source": "paper"
    },
    {
      "topic": "hyperparameter_optimization_dataset",
      "value": "Cora",
      "quote": "Its architectural hyperparameters have been optimized on the Cora dataset and are then reused for Cite-seer.",
      "source": "paper"
    },
    {
      "topic": "skip connections",
      "value": "employed skip connections across the intermediate attentional layer",
      "quote": "L2 regularization or dropout—we have, however, successfully employed skip connections (He et al., 2016) across the intermediate attentional layer.",
      "source": "paper"
    },
    {
      "topic": "batch size",
      "value": "2 graphs",
      "quote": "We utilize a batch size of 2 graphs during training.",
      "source": "paper"
    },
    {
      "topic": "Early stopping criterion",
      "value": "patience-based early stopping",
      "quote": "if curr_step == patience:\n                    print('Early stop! Min loss: ', vlss_mn, ', Max accuracy: ', vacc_mx)",
      "source": "repo:execute_cora.py@5af87e7"
    },
    {
      "topic": "Checkpoint saving condition",
      "value": "save when both validation accuracy improves and validation loss decreases",
      "quote": "if val_acc_avg/vl_step >= vacc_mx and val_loss_avg/vl_step <= vlss_mn:\n                    vacc_early_model = val_acc_avg/vl_step\n                    vlss_early_model = val_loss_avg/vl_step\n                    saver.save(sess, checkpt_file)",
      "source": "repo:execute_cora.py@5af87e7"
    },
    {
      "topic": "Best validation metrics tracking",
      "value": "track maximum validation accuracy and minimum validation loss",
      "quote": "vacc_mx = np.max((val_acc_avg/vl_step, vacc_mx))\n                vlss_mn = np.min((val_loss_avg/vl_step, vlss_mn))",
      "source": "repo:execute_cora.py@5af87e7"
    },
    {
      "topic": "Model restoration",
      "value": "restore best model from checkpoint before testing",
      "quote": "saver.restore(sess, checkpt_file)",
      "source": "repo:execute_cora.py@5af87e7"
    },
    {
      "topic": "Test batch evaluation",
      "value": "evaluate test set in batches, averaging loss and accuracy",
