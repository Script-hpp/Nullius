      "topic": "model architecture",
      "value": "two-layer GCN with ReLU after first layer and softmax output",
      "quote": "Our forward model then takes the simple form: Z = f (X, A ) = softmax ( ˆA ReLU ( ˆAXW (0) ) W (1) ).",
      "source": "paper"
    },
    {
      "topic": "optimizer / training procedure",
      "value": "batch gradient descent using the full dataset each iteration",
      "quote": "The neural network weights W (0) and W (1) are trained using gradient descent. In this work, we perform batch gradient descent using the full dataset for every training iteration...",
      "source": "paper"
    },
    {
      "topic": "dropout usage",
      "value": "dropout introduced for stochasticity",
      "quote": "Stochasticity in the training process is introduced via dropout (Srivastava et al., 2014).",
      "source": "paper"
    },
    {
      "topic": "model architecture",
      "value": "two-layer GCN",
      "quote": "we train a two-layer GCN as described in Section 3.1",
      "source": "paper"
    },
    {
      "topic": "test set size",
      "value": "1,000 labeled examples",
      "quote": "evaluate prediction accuracy on a test set of 1,000 labeled examples.",
      "source": "paper"
    },
    {
      "topic": "dataset splits",
      "value": "same as Yang et al. (2016) with additional validation set of 500 labeled examples",
      "quote": "We choose the same dataset splits as in Yang et al. (2016) with an additional validation set of 500 labeled examples for hyperparameter optimization",
      "source": "paper"
    },
    {
      "topic": "validation set usage",
      "value": "not used for training",
      "quote": "We do not use the validation set labels for training.",
      "source": "paper"
    },
    {
      "topic": "hyperparameter optimization scope",
      "value": "optimized on Cora only, same params for Citeseer and PubMed",
      "quote": "For the citation network datasets, we optimize hyperparameters on Cora only and use the same set of parameters for Citeseer and Pubmed.",
      "source": "paper"
    },
    {
      "topic": "max epochs",
      "value": "200 epochs",
      "quote": "We train all models for a maximum of 200 epochs (training iterations)",
      "source": "paper"
    },
    {
      "topic": "optimizer",
      "value": "Adam",
      "quote": "using Adam (Kingma & Ba, 2015)",
      "source": "paper"
    },
    {
      "topic": "learning rate",
      "value": "0.01",
      "quote": "with a learning rate of 0.01",
      "source": "paper"
    },
    {
      "topic": "early stopping criterion",
      "value": "window size 10 (stop if validation loss does not decrease for 10 consecutive epochs)",
      "quote": "and early stopping with a window size of 10, i.e. we stop training if the validation loss does not decrease for 10 consecutive epochs.",
      "source": "paper"
    },
    {
      "topic": "weight initialization",
      "value": "Glorot & Bengio (2010) initialization",
      "quote": "We initialize weights using the initialization described in Glorot & Bengio (2010)",
      "source": "paper"
    },
    {
      "topic": "feature normalization",
      "value": "(row-)normalize input feature vectors",
      "quote": "and accordingly (row-)normalize input feature vectors.",
      "source": "paper"
    },
    {
      "topic": "dropout rate",
      "value": "0.5 (applied to all layers)",
      "quote": "0.5 (dropout rate)",
      "source": "paper"
    },
    {
      "topic": "L2 regularization factor",
      "value": "5·10−4 (for first GCN layer)",
      "quote": "5 · 10 −4 (L2 regularization)",
      "source": "paper"
    },
    {
      "topic": "number of hidden units",
      "value": "16",
      "quote": "and 16 (number of hidden units)",
      "source": "paper"
    },
    {
      "topic": "evaluation protocol – repetitions",
      "value": "mean accuracy of 100 runs with random weight initializations",
      "quote": "We trained and tested our model on the same dataset splits as in Yang et al. (2016) and report mean accuracy of 100 runs with random weight initializations.",
      "source": "paper"
    },
    {
      "topic": "metric",
      "value": "classification accuracy in percent",
      "quote": "Reported numbers denote classification accuracy in percent.",
      "source": "paper"
    },
    {
      "topic": "cross_validation",
      "value": "5-fold cross-validation experiment on Cora, Citeseer and Pubmed datasets",
      "quote": "In these experiments, we investigate the influence of model depth (number of layers) on classification performance. We report results on a 5-fold cross-validation experiment on the Cora, Citeseer and Pubmed datasets (Sen et al., 2008) using all labels.",
      "source": "paper"
    },
    {
      "topic": "epochs",
      "value": "400 epochs (without early stopping)",
      "quote": "On each cross-validation split, we train for 400 epochs (without early stopping) using the Adam optimizer (Kingma & Ba, 2015) with a learning rate of 0.01.",
      "source": "paper"
    },
    {
      "topic": "dropout_rate",
      "value": "0.5 (dropout rate, first and last layer)",
      "quote": "Other hyperparameters are chosen as follows: 0.5 (dropout rate, first and last layer), 5 · 10 −4 (L2 regularization, first layer), 16 (number of units for each hidden layer) and 0.01 (learning rate).",
      "source": "paper"
    },
    {
      "topic": "Loss function",
      "value": "masked_softmax_cross_entropy",
      "quote": "self.loss += masked_softmax_cross_entropy(self.outputs, self.placeholders['labels'], self.placeholders['labels_mask'])",
      "source": "repo:gcn/models.py@39a4089"
    },
    {
      "topic": "Accuracy metric",
      "value": "masked_accuracy",
      "quote": "self.accuracy = masked_accuracy(self.outputs, self.placeholders['labels'], self.placeholders['labels_mask'])",
      "source": "repo:gcn/models.py@39a4089"
    },
    {
      "topic": "Model architecture - first GraphConvolution layer",
      "value": "input_dim=self.input_dim, output_dim=FLAGS.hidden1, act=tf.nn.relu, dropout=True, sparse_inputs=True",
      "quote": "self.layers.append(GraphConvolution(input_dim=self.input_dim,\n                                            output_dim=FLAGS.hidden1,\n                                            placeholders=self.placeholders,\n                                            act=tf.nn.relu,\n                                            dropout=True,\n                                            sparse_inputs=True,\n                                            logging=self.logging))",
      "source": "repo:gcn/models.py@39a4089"
    },
    {
      "topic": "Model architecture - second GraphConvolution layer",
      "value": "input_dim=FLAGS.hidden1, output_dim=self.output_dim, act=lambda x: x, dropout=True",
      "quote": "self.layers.append(GraphConvolution(input_dim=FLAGS.hidden1,\n                                            output_dim=self.output_dim,\n                                            placeholders=self.placeholders,\n                                            act=lambda x: x,\n                                            dropout=True,\n                                            logging=self.logging))",
      "source": "repo:gcn/models.py@39a4089"
    },
    {
      "topic": "Prediction",
      "value": "tf.nn.softmax(self.outputs)",
      "quote": "return tf.nn.softmax(self.outputs)",
      "source": "repo:gcn/models.py@39a4089"
    },
    {
      "topic": "weight_initialization",
      "value": "glorot([input_dim, output_dim])",
      "quote": "self.vars['weights_' + str(i)] = glorot([input_dim, output_dim],\n                                                        name='weights_' + str(i))",
      "source": "repo:gcn/layers.py@39a4089"
    },
    {
      "topic": "bias_initialization",
      "value": "zeros([output_dim])",
      "quote": "self.vars['bias'] = zeros([output_dim], name='bias')",
      "source": "repo:gcn/layers.py@39a4089"
    },
    {
      "topic": "dropout_application",
      "value": "applied to inputs: sparse_dropout if sparse_inputs else tf.nn.dropout with rate 1-self.dropout",
      "quote": "# dropout\n        if self.sparse_inputs:\n            x = sparse_dropout(x, 1-self.dropout, self.num_features_nonzero)\n        else:\n            x = tf.nn.dropout(x, 1-self.dropout)",
      "source": "repo:gcn/layers.py@39a4089"
    }
