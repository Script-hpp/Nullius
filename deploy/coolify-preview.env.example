# Erstes oeffentliches Coolify-Deployment: vorhandene Ergebnisse, Replay und PDF.
# Keine API-Schluessel erforderlich. Beide kostenpflichtigen Start-Endpunkte bleiben gesperrt.
# Diese Werte in Coolify als Runtime Environment Variables setzen, nicht als Build Variables.
LLM_PROVIDER=tokenfactory
SANDBOX_BACKEND=nebius
TAVILY_MODE=live
MAX_DAILY_REPRO_JOBS=0
MAX_DAILY_JOBS=0
MAX_DAILY_REPRO_PER_IP=1
MAX_DAILY_DISCOVER_PER_IP=1
ALLOW_FULL_RUNS=0
TRUST_PROXY=1
MAX_COST_PER_RUN_USD=0.50
MAX_COST_PER_DISCOVERY_USD=0.25
MAX_DAILY_COST_USD=0.75
LIVE_MIN_BUDGET_USD=6.0
LIVE_MIN_TAVILY_CREDITS=300
VAT_RATE=0.19
BUDGET_TOTAL_USD=
BUDGET_SINCE=
TAVILY_CREDITS_TOTAL=
TAVILY_CREDITS_SINCE=
REPRO_EXPORT_DIR=/data
LLM_CACHE=off
# Live erst nach Kontostand-/Credit-Abgleich und persistenten Volumes einschalten.
# Kostenbremsen und verbleibende Grenzen: docs/cost_policy_review.md.
# deploy/.env.example beschreibt dann Modelle, Schluessel und Budget-Stichtage.
