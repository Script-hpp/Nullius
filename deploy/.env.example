# Produktion (Nebius Token Factory). Werte eintragen, als deploy/.env speichern (nicht in Git), per --env-file oder Hosting-Secrets uebergeben.
# ---- Umgebung ----
LLM_PROVIDER=tokenfactory
SANDBOX_BACKEND=nebius
TAVILY_MODE=live                 # live: Tavily zur Laufzeit (Preis verlangt echten Aufruf); fixture nur fuer Tests

# ---- Token Factory ----
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
TF_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
TF_MODEL_CODE=nvidia/nemotron-3-super-120b-a12b
TF_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b

# ---- Tavily ----
TAVILY_API_KEY=

# ---- Offene Demo: Limits und harte Sperre (kein Zugangscode) ----
# Live-Laeufe starten nur, solange Budget und Tavily-Credits reichen; sonst HTTP 503/429 und /api/status meldet live=false,
# das Frontend zeigt dann die Wiedergabe mit ehrlichem Hinweis. Worst-Case-Rechnung und Stufenplan: docs/deploy.md, "Limits bis 15.12."
# STUFE 1 (Deployment bis 2026-11-30). Am 2026-12-01 auf Stufe 2 umstellen und von Hand neu deployen (nicht waehrend eines Laufs):
#   Stufe 2: MAX_DAILY_REPRO_JOBS=2, MAX_DAILY_COST_USD=1.25, LIVE_MIN_BUDGET_USD=1.0
LIVE_MIN_BUDGET_USD=6.0          # Stufe 1: Reserve fuer das Bewertungsfenster (01.-15.12.); Sperre, wenn BUDGET_TOTAL_USD minus Bruttokosten seit BUDGET_SINCE darunter faellt
MAX_DAILY_COST_USD=0.75          # Tagesbudget in $ brutto (lokaler Serverdatum-Tag, aus costs.jsonl, ueberlebt Neustart). 0 = aus. Sperrgrund "daily_limit"
LIVE_MIN_TAVILY_CREDITS=300      # Sperre, wenn TAVILY_CREDITS_TOTAL minus gezaehlte Credits seit TAVILY_CREDITS_SINCE darunter faellt
TAVILY_CREDITS_TOTAL=            # Credits zum Stichtag (Tavily-Dashboard); Zaehler: logs/tavily_usage.jsonl (Schaetzung, im Zweifel zu hoch)
TAVILY_CREDITS_SINCE=            # Stichtag (UTC), z. B. 2026-10-05T08:00Z; beim Aufladen beide neu setzen
MAX_DAILY_REPRO_JOBS=1           # Reproduktions-Laeufe pro Tag (Code-Standard 3); Stufe 1: 1, Stufe 2: 2
MAX_DAILY_JOBS=1                 # Discovery-Laeufe pro Tag (Code-Standard 5); ca. 16 Tavily-Credits je Lauf
MAX_DAILY_REPRO_PER_IP=1         # Reproduktionen je IP und Tag (IPv6 je /64)
MAX_DAILY_DISCOVER_PER_IP=1      # Discovery-Laeufe je IP und Tag
ALLOW_FULL_RUNS=0                # 0: die API erzwingt die Schnellpruefung (3 Seeds), auch wenn ein Client quick=false sendet; 1 nur fuer eigene Tests
TRUST_PROXY=1                    # 1 hinter Reverse-Proxy (Coolify/Caddy): zaehlt der letzte X-Forwarded-For-Eintrag. 0 NUR ohne Proxy (sonst zaehlen alle Besucher als eine IP)
# Tageszaehler und Limits je IP werden aus logs/live_jobs.jsonl (Hash der IP, keine Klartext-Adresse) nach einem Neustart wiederhergestellt.
# logs/ (costs.jsonl, tavily_usage.jsonl, live_jobs.jsonl) MUSS ein persistentes Volume sein, sonst springen Untergrenzen und Tageslimits auf "voll".

# ---- Schutz der API (Defaults reichen; nur anpassen, wenn noetig) ----
# RATE_LIMIT_PER_MIN=240         # Anfragen je IP und Minute auf /api/* (GET)
# RATE_LIMIT_POST_PER_MIN=10     # POST je IP und Minute
# MAX_BODY_BYTES=16384           # groesster Request-Body
# MAX_SSE_STREAMS=30             # offene Live-Streams insgesamt
# MAX_SSE_PER_IP=4               # offene Live-Streams je IP

# ---- Kostenbremsen ----
MAX_COST_PER_RUN_USD=0.50       # brutto je Lauf (Abbruch im Orchestrator). Gemessen: Schnellpruefung Autorencode-Modus 0,14 $, Mittel Plan A 0,25 $, Maximum 0,46 $ (recall cg v1, zwei Claims)
VAT_RATE=0.19
BUDGET_TOTAL_USD=12.00           # brutto: ANTEIL DES SERVERS (Konsolen-Kontostand 17,02 $ am 2026-10-09 minus ca. 5 $ Reserve fuer den lokalen Rechner), nicht der ganze Kontostand. PFLICHT: ohne BUDGET_TOTAL_USD und BUDGET_SINCE bleibt Live gesperrt
BUDGET_SINCE=                    # PFLICHT, Stichtag (UTC) = Zeitpunkt des Deployments, z. B. 2026-10-12T08:00Z (nur Log-Eintraege ab dann zaehlen)
MAX_ATTEMPTS_PER_CLAIM=4
LLM_CACHE=off                    # die API setzt den Cache fuer Live-Laeufe ohnehin aus

# ---- Export (persistentes Volume im Container: /data) ----
REPRO_EXPORT_DIR=/data

# ---- Nur fuer deploy/docker-compose.yml (Caddy) ----
SITE_ADDRESS=                    # z. B. 203-0-113-7.sslip.io (IP der VM mit Bindestrichen)
CADDYFILE=Caddyfile              # Caddyfile.selfsigned, wenn kein Hostname genutzt wird
