# Produktion (Nebius Token Factory). Werte eintragen, als deploy/.env speichern (nicht in Git), per --env-file oder Hosting-Secrets uebergeben.
# ---- Umgebung ----
LLM_PROVIDER=tokenfactory
SANDBOX_BACKEND=nebius
TAVILY_MODE=live                 # live: Tavily zur Laufzeit (Preis verlangt echten Aufruf); fixture nur fuer Tests

# ---- Token Factory ----
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
TF_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
TF_MODEL_CODE=nvidia/nemotron-3-super-120b-a12b
TF_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b

# ---- Tavily ----
TAVILY_API_KEY=

# ---- Offene Demo: Limits und harte Sperre (kein Zugangscode) ----
# Live-Laeufe starten nur, solange Budget und Tavily-Credits reichen; sonst HTTP 503 und /api/status meldet live=false.
LIVE_MIN_BUDGET_USD=3.0          # Sperre, wenn BUDGET_TOTAL_USD minus Bruttokosten seit BUDGET_SINCE darunter faellt
LIVE_MIN_TAVILY_CREDITS=300      # Sperre, wenn TAVILY_CREDITS_TOTAL minus gezaehlte Credits seit TAVILY_CREDITS_SINCE darunter faellt
TAVILY_CREDITS_TOTAL=            # Credits zum Stichtag (Tavily-Dashboard); Zaehler: logs/tavily_usage.jsonl (Schaetzung, im Zweifel zu hoch)
TAVILY_CREDITS_SINCE=            # Stichtag (UTC), z. B. 2026-10-05T08:00Z; beim Aufladen beide neu setzen
MAX_DAILY_REPRO_PER_IP=1         # Reproduktionen je IP und Tag
MAX_DAILY_DISCOVER_PER_IP=1      # Discovery-Laeufe je IP und Tag
TRUST_PROXY=0                    # 1 nur hinter einem Reverse-Proxy, der X-Forwarded-For setzt (Coolify/Caddy): dann zaehlt der letzte Eintrag
MAX_DAILY_JOBS=1                 # Discovery-Laeufe pro Tag (Code-Standard 5); ca. 16 Tavily-Credits je Lauf; Rechnung: docs/deploy.md, "Limits bis 15.12."
MAX_DAILY_REPRO_JOBS=1           # Reproduktions-Laeufe pro Tag (Code-Standard 3); bis 2026-11-30 1, ab 2026-12-01 (Bewertung) 3, dann neu deployen
# Tageszaehler und IP-Limits liegen im Speicher (Neustart setzt sie zurueck). logs/ (costs.jsonl, tavily_usage.jsonl) MUSS ein persistentes Volume sein, sonst springen die Untergrenzen auf "voll".

# ---- Kostenbremsen ----
MAX_COST_PER_RUN_USD=            # brutto je Lauf (Standard siehe CLAUDE.md: 0.50)
VAT_RATE=0.19
BUDGET_TOTAL_USD=                # brutto: ANTEIL DES SERVERS (docs/budget_plan.md: 20.00), nicht der ganze Kontostand; lokaler Rechner hat ein eigenes Log
BUDGET_SINCE=                    # Stichtag (UTC), z. B. 2026-10-05T08:00Z
MAX_ATTEMPTS_PER_CLAIM=4
LLM_CACHE=off                    # die API setzt den Cache fuer Live-Laeufe ohnehin aus

# ---- Export (persistentes Volume im Container: /data) ----
REPRO_EXPORT_DIR=/data

# ---- Nur fuer deploy/docker-compose.yml (Caddy) ----
SITE_ADDRESS=                    # z. B. 203-0-113-7.sslip.io (IP der VM mit Bindestrichen)
CADDYFILE=Caddyfile              # Caddyfile.selfsigned, wenn kein Hostname genutzt wird
