# ---- Umgebung ----
LLM_PROVIDER=openrouter          # openrouter | tokenfactory
SANDBOX_BACKEND=nebius           # local | nebius (Beta genehmigt, kostenlos)

# ---- OpenRouter (Prototyp) ----
OPENROUTER_API_KEY=
OR_MODEL_FAST=nvidia/nemotron-3.5-lightning:free
OR_MODEL_CODE=nvidia/nemotron-3-super-120b-a12b:free
OR_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b:free   # bewusst Super

# ---- Token Factory (Prod) ----
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
TF_MODEL_FAST=nvidia/Nemotron-3_5-Lightning        # geprueft via GET /v1/models, 2026-09-28
TF_MODEL_CODE=nvidia/nemotron-3-super-120b-a12b
TF_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b   # Ultra seit 2026-10-09 nicht mehr auf Token Factory (404)

# ---- Tavily ----
TAVILY_API_KEY=

# ---- Kostenbremsen ----
MAX_COST_PER_RUN_USD=0.50        # brutto (inkl. MwSt.). Benchmark v2-v4 liefen mit 0.50. Produkt-Standardmodus (Autorencode): 0.75, siehe deploy/.env.example
MAX_ATTEMPTS_PER_CLAIM=4
LLM_CACHE=on                     # on | off
TAVILY_MODE=live                 # live (Standard: Paper-Text und README bei jedem Lauf per Tavily) | fixture (gespeicherte Fassungen; Tests und Experimente)
VAT_RATE=0.19                    # Log speichert netto, Limits und Budget gelten brutto
BUDGET_TOTAL_USD=29.75           # brutto, Kontostand zum Stichtag; ab 80 % Warnung, ab 95 % Abbruch
BUDGET_SINCE=2026-09-29T08:00Z   # Stichtag (UTC): nur Log-Eintraege ab dann zaehlen; beim Aufladen beide neu setzen
# ---- Live-Sperre der API (nur Server; Standardwerte im Code, siehe deploy/.env.example) ----
LIVE_MIN_BUDGET_USD=3.0          # Live-Start nur, solange Rest-Budget (brutto) darueber liegt
TAVILY_CREDITS_TOTAL=1000        # Credits zum Stichtag; Zaehler logs/tavily_usage.jsonl
TAVILY_CREDITS_SINCE=            # Stichtag (UTC)
LIVE_MIN_TAVILY_CREDITS=300      # Live-Start nur, solange Rest-Credits darueber liegen
MAX_DAILY_REPRO_PER_IP=1
MAX_DAILY_DISCOVER_PER_IP=1
TRUST_PROXY=0                    # 1 nur hinter Reverse-Proxy
