# ---- Umgebung ----
LLM_PROVIDER=openrouter          # openrouter | tokenfactory
SANDBOX_BACKEND=nebius           # local | nebius (Beta genehmigt, kostenlos)

# ---- OpenRouter (Prototyp) ----
OPENROUTER_API_KEY=
OR_MODEL_FAST=nvidia/nemotron-3.5-lightning:free
OR_MODEL_CODE=nvidia/nemotron-3-super-120b-a12b:free
OR_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b:free   # Ultra waere auch :free verfuegbar, bewusst Super gewaehlt

# ---- Token Factory (Prod) ----
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
TF_MODEL_FAST=TODO               # Nano oder 3.5 Lightning, ID via GET /v1/models pruefen
TF_MODEL_CODE=TODO               # Super
TF_MODEL_REASONING=TODO          # Ultra

# ---- Tavily ----
TAVILY_API_KEY=

# ---- Kostenbremsen ----
MAX_COST_PER_RUN_USD=0.50
MAX_ATTEMPTS_PER_CLAIM=4
LLM_CACHE=on                     # on | off
